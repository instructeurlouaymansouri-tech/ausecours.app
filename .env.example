# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only, never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# Server-side only. The chat API route calls Gemini from the server,
# so this key is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Maps (OpenStreetMap needs no key; kept here in case you swap providers later) ---
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_EMERGENCY_NUMBER=190
